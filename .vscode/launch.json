{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Streamlit App",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Python: Train Model (train.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Predict CLI (predict.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/predict.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
